{
  "servers": {
    "anki": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/mkrech/anki-mcp-server",
        "anki-mcp-server"
      ]
    },
    "anki-course-tutor": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/mkrech/anki-course-tutor-mcp-server",
        "anki-course-tutor"
      ],
      "env": {
        "ANKI_COURSE_TUTOR_CONFIG": "/Users/michaelkrech/_work/anki-course-tutor-mcp-server/config.yaml"
      }
    }
  }
}
